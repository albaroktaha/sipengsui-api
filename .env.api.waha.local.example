# SIPENGSUI API environment for compose.waha.local.yaml only.
# Copy to .env.api.waha.local and keep the real file untracked.
# This file belongs to the API service, not to the WAHA container.

DATABASE_URL=postgresql://sipengsui_local:sipengsui_local@db:5432/sipengsui_local?schema=public
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=3000
CORS_ORIGIN=http://localhost:3001
TRUST_PROXY=0
APP_URL=http://localhost:3001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

NEWS_STORAGE_DRIVER=local
NEWS_STORAGE_PUBLIC_URL=http://localhost:3000
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

REKOMTEK_BERKAS_STORAGE_DIR=/app/storage/rekomtek-berkas
REKOMTEK_DRIVE_TIMEOUT_MS=10000
REKOMTEK_DEFAULT_MAX_FILE_SIZE_BYTES=10485760
REKOMTEK_ANTIVIRUS_COMMAND=clamscan
REKOMTEK_ANTIVIRUS_ARGS='["--infected","--no-summary","{file}"]'
REKOMTEK_ANTIVIRUS_TIMEOUT_MS=120000
CLAMAV_FRESHCLAM_CHECKS=12
CLAMAV_FRESHCLAM_DAEMON=true

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=10000
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Sipengsui <noreply@localhost>
VERIFY_TOKEN_TTL_MINUTES=60
VERIFY_RESEND_COOLDOWN_MINUTES=5
TURNSTILE_SECRET_KEY=
SESSION_IDLE_TIMEOUT_MINUTES=120

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_CHAT_ENABLED=false
AI_MAX_INPUT_CHARS=4000
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_OUTPUT_TOKENS=900
AI_RATE_LIMIT=10
AI_RATE_TTL_MS=60000

# Keep false until WAHA is paired, WORKING, and the verifier passes.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=waha
WAHA_BASE_URL=http://waha:3000
# Must be the same outbound API key as .env.waha.local:WAHA_API_KEY.
WAHA_API_KEY=
WAHA_SESSION=default
# Must be the same HMAC key entered in the local WAHA session webhook.
# It must be different from WAHA_API_KEY.
WAHA_WEBHOOK_HMAC_KEY=
WAHA_WEBHOOK_CUSTOM_SECRET=
WAHA_EXPECTED_ENGINE=WEBJS
WAHA_WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
WAHA_SESSION_HEALTH_CACHE_MS=10000
WAHA_SEND_MIN_INTERVAL_MS=1500
WHATSAPP_DEFAULT_COUNTRY_CODE=62
WHATSAPP_DEFAULT_LANGUAGE=id
WHATSAPP_WEBHOOK_MAX_BODY_BYTES=262144
WHATSAPP_OUTBOX_BATCH_SIZE=25
WHATSAPP_DISPATCH_LOCK_TTL_MS=120000
WHATSAPP_MAX_ATTEMPTS=6
WHATSAPP_INBOX_MAX_ATTEMPTS=6
WHATSAPP_INBOX_RETRY_BASE_MS=15000
WHATSAPP_CONNECT_TIMEOUT_MS=5000
WHATSAPP_RESPONSE_TIMEOUT_MS=10000
WHATSAPP_RETENTION_DAYS=90
WHATSAPP_PAIRING_TTL_MINUTES=10
WHATSAPP_PAIRING_MAX_ATTEMPTS=5
WHATSAPP_PAIRING_RATE_LIMIT=10
WHATSAPP_PAIRING_RATE_WINDOW_MINUTES=15
WHATSAPP_CONVERSATION_STATE_TTL_MINUTES=30
WHATSAPP_SERVICE_WINDOW_HOURS=24
WHATSAPP_AI_RATE_LIMIT=10
WHATSAPP_AI_RATE_WINDOW_MINUTES=1
WHATSAPP_STATUS_RATE_LIMIT=10
WHATSAPP_STATUS_RATE_WINDOW_MINUTES=1
WHATSAPP_CONSENT_TEXT_VERSION=v1
WHATSAPP_MESSAGE_STAGE_CHANGED_VERSION=v1
WHATSAPP_MESSAGE_CORRECTION_REQUIRED_VERSION=v1
WHATSAPP_MESSAGE_EXPOSE_SCHEDULED_VERSION=v2
WHATSAPP_MESSAGE_EXPOSE_RESCHEDULED_VERSION=v2
WHATSAPP_MESSAGE_EXPOSE_CANCELLED_VERSION=v2
WHATSAPP_MESSAGE_EXPOSE_REMINDER_VERSION=v2
WHATSAPP_EXPOSE_REMINDERS_ENABLED=false
WHATSAPP_EXPOSE_REMINDER_OFFSETS_MINUTES=1440,60
# Optional fixed official group for Expose notifications (format: digits@g.us)
WHATSAPP_EXPOSE_GROUP_ID=
WHATSAPP_MESSAGE_REJECTED_VERSION=v1
WHATSAPP_MESSAGE_PUBLISHED_VERSION=v1
WHATSAPP_MESSAGE_CONVERSATION_REPLY_VERSION=v1

MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_PROJECT_ID=
MODEL_ARMOR_LOCATION=
MODEL_ARMOR_TEMPLATE_ID=

# Seed development hanya untuk volume database lokal/baru.
SEED_ENV=development
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
RUN_SEED=false
