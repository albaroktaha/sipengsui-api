# SIPENGSUI API — Docker environment template
# 1) Copy file ini menjadi `.env.docker`
# 2) Isi nilai sesuai lingkungan Anda
# 3) Jalankan: docker compose up -d --build

# ── Database (untuk compose, host = nama service `db`) ─────────────────────
# DATABASE_URL di-override otomatis oleh docker-compose.yml
# (postgresql://user:pass@db:5432/sipengsui?schema=public)
POSTGRES_USER=sipengsui
POSTGRES_PASSWORD=sipengsui
POSTGRES_DB=sipengsui

# Port API yang dipetakan ke host (default 3000)
API_PORT=3000

# ── Auth ────────────────────────────────────────────────────────────────────
# WAJIB ganti dengan secret panjang & acak di production!
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────────────────────────────────
# Asal frontend (CORS). Ganti dengan domain web di production.
CORS_ORIGIN=http://localhost:3001

# ── Mail (SMTP) ─────────────────────────────────────────────────────────────
# Kosongkan MAIL_HOST untuk mode dev (email hanya di-log ke console)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Sipengsui <noreply@sipengsui.id>

# ── Email Verification ──────────────────────────────────────────────────────
# URL aplikasi web yang menerima link verifikasi
APP_URL=http://localhost:3001
VERIFY_TOKEN_TTL_MINUTES=60
VERIFY_RESEND_COOLDOWN_MINUTES=5

# ── reCAPTCHA v2 ────────────────────────────────────────────────────────────
# Kosongkan RECAPTCHA_SECRET_KEY untuk mode dev (captcha dilewati)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# ── Session idle timeout ────────────────────────────────────────────────────
SESSION_IDLE_TIMEOUT_MINUTES=120

# ── Gemini AI (Asisten SIPENGSUI) ───────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_CHAT_ENABLED=true
AI_MAX_INPUT_CHARS=4000
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_OUTPUT_TOKENS=900
AI_RATE_LIMIT=10
AI_RATE_TTL_MS=60000

# ── Model Armor (opsional) ──────────────────────────────────────────────────
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_PROJECT_ID=
MODEL_ARMOR_LOCATION=
MODEL_ARMOR_TEMPLATE_ID=

# ── Seed ────────────────────────────────────────────────────────────────────
# Set true sekali pada deploy pertama untuk mengisi data awal (admin, dll).
# Set false / hapus setelahnya agar seed tidak berjalan lagi.
RUN_SEED=false
