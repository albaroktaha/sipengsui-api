# SIPENGSUI API — Environment Variables
# Salin file ini menjadi .env dan isi nilai sesuai lingkungan Anda.

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/sipengsui?schema=public"

# ── Seed ─────────────────────────────────────────────────────────────
# Mode seed: development (default, boleh reset data) atau production
# (idempotent — tidak pernah menghapus data).
# SEED_ENV=production
# Password superadmin untuk seed. WAJIB diisi saat SEED_ENV=production;
# hanya dipakai saat akun superadmin baru dibuat (pertama kali deploy).
# SEED_ADMIN_PASSWORD=""
# Email superadmin (opsional, default sipengsui@gmail.com)
# SEED_ADMIN_EMAIL=""

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ── OAuth Google & GitHub ──────────────────────────────────────────
# Buat OAuth app di Google Cloud Console dan GitHub Developer Settings.
# Callback lokal:
#   http://localhost:3000/auth/google/callback
#   http://localhost:3000/auth/github/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/auth/github/callback"

# ── Server ──────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN="http://localhost:3001"
# Jumlah reverse proxy di depan API; 0 untuk akses langsung saat development.
TRUST_PROXY=0

# ── News CMS storage ─────────────────────────────────────────────────────────
# local: simpan ke ./uploads/news (development). s3/r2: object storage.
NEWS_STORAGE_DRIVER=local
NEWS_STORAGE_PUBLIC_URL="http://localhost:3000"
S3_ENDPOINT=""
S3_REGION=auto
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ── Rekomtek berkas checklist ──────────────────────────────────────
# Storage privat (tidak disajikan oleh static /uploads)
REKOMTEK_BERKAS_STORAGE_DIR="./storage/rekomtek-berkas"
REKOMTEK_DRIVE_TIMEOUT_MS=10000
REKOMTEK_DEFAULT_MAX_FILE_SIZE_BYTES=10485760
# Isi dengan executable scanner (contoh: clamscan). Kosong = Pending Check.
REKOMTEK_ANTIVIRUS_COMMAND=""
# Opsional JSON array argumen. Gunakan {file} sebagai placeholder path file.
# Windows Defender: ["-Scan","-ScanType","3","-File","{file}","-DisableRemediation"]
REKOMTEK_ANTIVIRUS_ARGS=""
REKOMTEK_ANTIVIRUS_TIMEOUT_MS=30000

# ── Mail (SMTP Gmail) ──────────────────────────────────────────────
# Gunakan Gmail App Password, bukan password akun biasa.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=10000
MAIL_USER="sipengsui@gmail.com"
MAIL_PASS=""          # Gmail App Password 16 karakter
MAIL_FROM="Sipengsui <sipengsui@gmail.com>"

# ── Email Verification ─────────────────────────────────────────────
APP_URL="http://localhost:3001"
VERIFY_TOKEN_TTL_MINUTES=60
VERIFY_RESEND_COOLDOWN_MINUTES=5

# ── Cloudflare Turnstile (anti-robot) ─────────────────────────────
# Secret key dari Cloudflare Turnstile dashboard. Wajib diisi.
TURNSTILE_SECRET_KEY=""

# ── Session idle timeout ──────────────────────────────────────────
# Auto-logout jika tidak ada aktivitas selama N menit
SESSION_IDLE_TIMEOUT_MINUTES=120

# ── Gemini AI (Asisten SIPENGSUI) ────────────────────────────────────
# Dapatkan key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.5-flash

# Kill switch fitur chatbot
AI_CHAT_ENABLED=true
# Batas panjang input pesan pengguna (karakter)
AI_MAX_INPUT_CHARS=4000
# Jumlah pesan terakhir yang dikirim ke model
AI_MAX_HISTORY_MESSAGES=12
# Batas token output per jawaban
AI_MAX_OUTPUT_TOKENS=900
# Rate limit per IP (request per jendela waktu)
AI_RATE_LIMIT=10
AI_RATE_TTL_MS=60000

# ── WhatsApp WAHA/SumoPod (MVP, disabled by default) ───────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER="waha"
WAHA_BASE_URL=""
WAHA_API_KEY=""
WAHA_SESSION="default"
WAHA_WEBHOOK_HMAC_KEY=""
WAHA_WEBHOOK_CUSTOM_SECRET=""
WAHA_EXPECTED_ENGINE=""
WAHA_WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
WAHA_SESSION_HEALTH_CACHE_MS=10000
WAHA_SEND_MIN_INTERVAL_MS=1500
WHATSAPP_DEFAULT_COUNTRY_CODE="62"
WHATSAPP_DEFAULT_LANGUAGE="id"
WHATSAPP_WEBHOOK_MAX_BODY_BYTES=262144
WHATSAPP_OUTBOX_BATCH_SIZE=25
WHATSAPP_DISPATCH_LOCK_TTL_MS=120000
WHATSAPP_MAX_ATTEMPTS=6
WHATSAPP_INBOX_MAX_ATTEMPTS=6
WHATSAPP_INBOX_RETRY_BASE_MS=15000
WHATSAPP_CONNECT_TIMEOUT_MS=5000
WHATSAPP_RESPONSE_TIMEOUT_MS=10000
WHATSAPP_RETENTION_DAYS=90
WHATSAPP_PAIRING_TTL_MINUTES=10
WHATSAPP_PAIRING_MAX_ATTEMPTS=5
WHATSAPP_PAIRING_RATE_LIMIT=10
WHATSAPP_PAIRING_RATE_WINDOW_MINUTES=15
WHATSAPP_CONVERSATION_STATE_TTL_MINUTES=30
WHATSAPP_SERVICE_WINDOW_HOURS=24
WHATSAPP_AI_RATE_LIMIT=10
WHATSAPP_AI_RATE_WINDOW_MINUTES=1
WHATSAPP_STATUS_RATE_LIMIT=10
WHATSAPP_STATUS_RATE_WINDOW_MINUTES=1
WHATSAPP_CONSENT_TEXT_VERSION="v1"
WHATSAPP_MESSAGE_STAGE_CHANGED_VERSION="v1"
WHATSAPP_MESSAGE_CORRECTION_REQUIRED_VERSION="v1"
WHATSAPP_MESSAGE_EXPOSE_SCHEDULED_VERSION="v1"
WHATSAPP_MESSAGE_EXPOSE_RESCHEDULED_VERSION="v1"
WHATSAPP_MESSAGE_EXPOSE_CANCELLED_VERSION="v1"
WHATSAPP_MESSAGE_EXPOSE_REMINDER_VERSION="v1"
WHATSAPP_EXPOSE_REMINDERS_ENABLED=false
WHATSAPP_EXPOSE_REMINDER_OFFSETS_MINUTES="1440,60"
WHATSAPP_MESSAGE_REJECTED_VERSION="v1"
WHATSAPP_MESSAGE_PUBLISHED_VERSION="v1"
WHATSAPP_MESSAGE_CONVERSATION_REPLY_VERSION="v1"

# ── Model Armor (opsional, nonaktif secara default) ──────────────────
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_PROJECT_ID=
MODEL_ARMOR_LOCATION=
MODEL_ARMOR_TEMPLATE_ID=
