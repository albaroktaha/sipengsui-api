# WAHA provider environment for compose.waha.local.yaml only.
# Copy to .env.waha.local and keep the real file untracked.
# This file belongs to the WAHA service, not to sipengsui-api.
# Compose defaults to devlikeapro/waha:chrome-2026.8.1 (amd64/Windows x64).
# ARM hosts override WAHA_LOCAL_IMAGE at command invocation; it is not a
# container environment variable.

# Must equal .env.api.waha.local:WAHA_API_KEY.
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

# Host-facing URL. Container-to-container API traffic uses http://waha:3000.
WAHA_BASE_URL=http://localhost:3002
WAHA_PUBLIC_URL=http://localhost:3002
WAHA_DASHBOARD_ENABLED=true
WHATSAPP_SWAGGER_ENABLED=false

# Must equal sipengsui-api:WAHA_EXPECTED_ENGINE.
WHATSAPP_DEFAULT_ENGINE=WEBJS
WAHA_NAMESPACE=all
WAHA_CLIENT_DEVICE_NAME=SIPENGSUI-LOCAL

WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=false
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media
