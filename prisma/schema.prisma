// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  PETUGAS
  PIMPINAN
  USER
}

enum StationType {
  ARR
  AWLR
}

enum ObservationSource {
  MANUAL
  IMPORT_EXCEL
  SENSOR
  API
}

enum ImportType {
  ARR
  AWLR
}

enum JenisPermohonan {
  IZIN_BARU
  PERPANJANGAN
}

enum RekomtekStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum RekomtekWorkflowStage {
  PEMOHON_DRAFT
  MENUNGGU_PENUNJUKAN_POKJA
  EVALUASI_DOKUMEN_AWAL
  PERBAIKAN_AWAL_PEMOHON
  EVALUASI_DOKUMEN_ULANG
  PENYUSUNAN_SURAT_PENOLAKAN
  DITOLAK
  MENUNGGU_JADWAL_EKSPOSE
  EKSPOSE_TERJADWAL
  MENUNGGU_BA_EKSPOSE
  VERIFIKASI_HASIL_EKSPOSE
  PERBAIKAN_PASCA_EKSPOSE
  VERIFIKASI_PERBAIKAN_PASCA_EKSPOSE
  MENUNGGU_SPT_LAPANGAN
  KUNJUNGAN_LAPANGAN_DITUGASKAN
  MENUNGGU_BA_LAPANGAN
  PERSIAPAN_SIDANG_REKOMTEK
  MENUNGGU_BA_SIDANG_REKOMTEK
  PENYUSUNAN_HASIL_REKOMTEK
  PEMERIKSAAN_PEJABAT
  MENUNGGU_PERSETUJUAN_ATASAN
  DISETUJUI_ATASAN
  DOKUMEN_REKOMTEK_TERBIT
}

enum RekomtekAssignmentMemberRole {
  KOORDINATOR
  ANGGOTA
}

enum RekomtekReviewType {
  EVALUASI_AWAL
  EVALUASI_ULANG
  PASCA_EKSPOSE
  VERIFIKASI_PASCA_EKSPOSE
}

enum RekomtekReviewDecision {
  MEMENUHI
  DIKEMBALIKAN
  TIDAK_MEMENUHI
}

enum RekomtekFindingStatus {
  TERBUKA
  TERJAWAB
  DITUTUP
}

enum RekomtekExposeMethod {
  LURING
  DARING
  HIBRID
}

enum RekomtekExposeStatus {
  DRAFT
  TERJADWAL
  SELESAI
  DIBATALKAN
}

enum RekomtekFieldVisitStatus {
  DITUGASKAN
  SELESAI
}

enum RekomtekArtifactType {
  UNDANGAN_EKSPOSE
  BERITA_ACARA_EKSPOSE
  SURAT_PENOLAKAN
  SPT_LAPANGAN
  BERITA_ACARA_LAPANGAN
  BERITA_ACARA_SIDANG_REKOMTEK
  SURAT_PERSETUJUAN
  DRAFT_REKOMTEK
  DOKUMEN_REKOMTEK
}

enum RekomtekArtifactStatus {
  DRAFT
  FINAL
}

enum WhatsAppIdentityStatus {
  ACTIVE
  UNLINKED
  BLOCKED
}

enum WhatsAppConsentPurpose {
  REKOMTEK_TRANSACTIONAL
  SERVICE_CONVERSATION
}

enum WhatsAppConsentSource {
  WEB
  WHATSAPP
  ADMIN
}

enum WhatsAppPairingStatus {
  PENDING
  CONSUMED
  EXPIRED
  REVOKED
}

enum WhatsAppConversationState {
  MENU
  AWAITING_PAIRING
  AWAITING_TRANSACTIONAL_CONSENT
  AWAITING_SERVICE_CONSENT
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  LOCATION
  CONTACTS
  UNKNOWN
}

enum WhatsAppInboundStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum WhatsAppOutboxStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  READ
  RETRY
  FAILED
  DEAD
  CANCELLED
  STALE
}

enum WhatsAppDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum BerkasSourceType {
  UPLOAD
  GOOGLE_DRIVE
}

enum BerkasTechnicalStatus {
  VALID
  INVALID
  PENDING_CHECK
}

enum BerkasReviewStatus {
  PENDING
  VERIFIED
  NEEDS_CORRECTION
}

enum DisasterReportStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DisasterSeverity {
  RINGAN
  SEDANG
  BERAT
}

enum DisasterType {
  BANJIR
  GEMPA
  LONGSOR
  KEKERINGAN
  ANGIN_TOPAN
  KEBAKARAN_HUTAN
  GELOMBANG_PASANG
  LAINNYA
}

enum NewsStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Rekomtek {
  id String @id @default(uuid())

  // Relasi versi pengajuan: record lama tetap immutable saat Ajukan Ulang
  revisionNumber    Int        @default(1)
  sourceRevision    Int        @default(0)
  checklistRevision Int        @default(0)
  parentRekomtekId  String?
  parentRekomtek    Rekomtek?  @relation("RekomtekRevisions", fields: [parentRekomtekId], references: [id], onDelete: Restrict)
  revisions         Rekomtek[] @relation("RekomtekRevisions")

  // ===========================
  // Dokumen Identity
  // ===========================

  nomor     String  @unique
  judul     String
  jenis     String
  deskripsi String?

  // ===========================
  // Status Workflow
  // ============================

  status                    RekomtekStatus         @default(DRAFT)
  workflowStage             RekomtekWorkflowStage?
  initialCorrectionCount    Int                    @default(0)
  workflowVersion           Int                    @default(0)
  workflowMigrationRequired Boolean                @default(false)
  workflowMigrationNote     String?
  approvedDraftArtifactId   String?
  publishedArtifactId       String?

  // ===========================
  // Jenis Permohonan
  // ===========================

  jenisPermohonan JenisPermohonan @default(IZIN_BARU)

  // ===========================
  // Referensi Geografis
  // ===========================

  stationId String?
  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  riverId String?
  river   River?  @relation(fields: [riverId], references: [id], onDelete: SetNull)

  customRiverName String?

  watershedId String?
  watershed   Watershed? @relation(fields: [watershedId], references: [id], onDelete: SetNull)

  riverRegionId String?
  riverRegion   RiverRegion? @relation(fields: [riverRegionId], references: [id], onDelete: SetNull)

  // ===========================
  // Data Analisis
  // ===========================

  analysisData Json?
  parameters   Json?

  // ===========================
  // Dokumen Output
  // ===========================

  fileUrl String?

  // ===========================
  // Checklist Berkas
  // ===========================

  berkas          RekomtekBerkas[]
  teamAssignments RekomtekTeamAssignment[]
  reviewRounds    RekomtekReviewRound[]
  exposeSchedules RekomtekExposeSchedule[]
  fieldVisits     RekomtekFieldVisit[]
  councilSessions RekomtekCouncilSession[]
  artifacts       RekomtekArtifact[]
  workflowEvents  RekomtekWorkflowEvent[]
  notifications   RekomtekNotification[]

  // ===========================
  // Audit Workflow
  // ===========================

  createdBy     String
  createdById   String?
  createdByUser User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy    String?
  approvedBy    String?

  reviewedAt  DateTime?
  approvedAt  DateTime?
  publishedAt DateTime?

  // ===========================
  // Audit Timestamps
  // ===========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([stationId])
  @@index([riverId])
  @@index([watershedId])
  @@index([riverRegionId])
  @@index([createdById])
  @@index([createdAt])
  @@index([parentRekomtekId])
  @@index([workflowStage])
  @@index([status, workflowStage])
}

model User {
  id String @id @default(uuid())

  firstName    String
  lastName     String
  email        String  @unique
  pendingEmail String?
  password     String?

  phone        String?
  organization String?
  address      String?
  avatar       String?

  accounts Account[]

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  termsAcceptedAt DateTime?

  lastLoginAt    DateTime?
  lastActivityAt DateTime?

  // Multi-role & permissions
  userRoles       UserRole[]
  userPermissions UserPermission[]

  whatsappIdentity     WhatsAppIdentity?
  whatsappPairingCodes WhatsAppPairingCode[]

  // Rekomtek yang diajukan user
  rekomteks Rekomtek[]

  // Berita yang ditulis dan revisinya
  newsArticles  NewsArticle[]         @relation("NewsArticleAuthor")
  newsRevisions NewsArticleRevision[] @relation("NewsRevisionAuthor")

  // Email verification & password reset
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Role {
  id String @id @default(uuid())

  name RoleType @unique

  users     User[]
  userRoles UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id String @id @default(uuid())

  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Permission {
  id String @id @default(uuid())

  slug        String  @unique
  name        String
  description String?
  group       String

  userPermissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPermission {
  id String @id @default(uuid())

  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, permissionId])
}

// Token verifikasi email — dibuat saat register / kirim ulang
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Token reset password — siap untuk fitur lupa password
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model DisasterReport {
  id String @id @default(uuid())

  // Pelapor publik tidak wajib login, maka userId nullable
  userId String?

  judul     String
  jenis     DisasterType
  deskripsi String

  // Identitas pelapor (publik)
  reporterName  String
  reporterPhone String

  lokasi   Json? // { lat, lng, address, village, district }
  severity DisasterSeverity?
  status   DisasterReportStatus @default(DRAFT)

  tanggalKejadian DateTime @default(now())
  attachments     Json? // array of file URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([jenis])
}

model RiverRegion {
  id String @id @default(uuid())

  code String? @unique
  slug String? @unique

  name String

  geometry Json?

  description String?

  sourceGisMapId String?
  sourceGisMap   GisMap? @relation("RiverRegionSourceMap", fields: [sourceGisMapId], references: [id], onDelete: SetNull)

  status Boolean @default(true)

  publishedAt DateTime?

  watersheds Watershed[]
  rekomteks  Rekomtek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceGisMapId])
}

model Watershed {
  id String @id @default(uuid())

  riverRegionId String
  riverRegion   RiverRegion @relation(fields: [riverRegionId], references: [id])

  code String? @unique
  slug String? @unique

  name String

  area Float?

  geometry Json?

  description String?

  sourceGisMapId String?
  sourceGisMap   GisMap? @relation("WatershedSourceMap", fields: [sourceGisMapId], references: [id], onDelete: SetNull)

  status Boolean @default(true)

  publishedAt DateTime?

  rivers River[]

  stations  Station[]
  rekomteks Rekomtek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceGisMapId])
}

model River {
  id String @id @default(uuid())

  watershedId String
  watershed   Watershed @relation(fields: [watershedId], references: [id])

  parentRiverId String?
  parentRiver   River?  @relation("RiverHierarchy", fields: [parentRiverId], references: [id])

  childRivers River[] @relation("RiverHierarchy")

  code String? @unique
  slug String? @unique

  name String

  orderNumber Int?

  length Float?

  geometry Json?

  description String?

  sourceGisMapId String?
  sourceGisMap   GisMap? @relation("RiverSourceMap", fields: [sourceGisMapId], references: [id], onDelete: SetNull)

  status Boolean @default(true)

  publishedAt DateTime?

  stations Station[] @relation("RiverStations")

  rekomteks Rekomtek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceGisMapId])
}

model Station {
  id String @id @default(uuid())

  watershedId String
  watershed   Watershed @relation(fields: [watershedId], references: [id])

  riverId String?
  river   River?  @relation("RiverStations", fields: [riverId], references: [id])

  code String? @unique

  name String

  type StationType

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  elevation Decimal? @db.Decimal(8, 2)

  operatorName String?

  village  String?
  district String?
  regency  String?

  installationYear Int?

  description String?

  status Boolean @default(true)

  publishedAt DateTime?

  observations Observation[]
  rekomteks    Rekomtek[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  importHistories ImportHistory[]
}

model Observation {
  id String @id @default(uuid())

  // ===========================
  // Relasi
  // ===========================

  stationId String
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  importHistoryId String?
  importHistory   ImportHistory? @relation(fields: [importHistoryId], references: [id], onDelete: SetNull)

  // ===========================
  // Waktu Observasi
  // ===========================

  observationDate DateTime

  // ===========================
  // Data Hidrologi
  // ===========================

  rainfall Decimal? @db.Decimal(8, 2)

  waterLevel Decimal? @db.Decimal(8, 2)

  discharge Decimal? @db.Decimal(10, 2)

  // ===========================
  // Metadata
  // ===========================

  observerName String?

  source ObservationSource @default(MANUAL)

  note String?

  isValid Boolean @default(true)

  verifiedAt DateTime?

  details ObservationDetail[]

  // ===========================
  // Audit
  // ===========================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([stationId, observationDate])
  @@index([stationId])
  @@index([observationDate])
  @@index([stationId, observationDate])
  @@index([source])
  @@index([importHistoryId])
}

model ObservationDetail {
  id String @id @default(uuid())

  // ===========================
  // Relasi
  // ===========================

  observationId String

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  // ===========================
  // Data
  // ===========================

  observationTime String

  waterLevel Decimal? @db.Decimal(8, 2)

  discharge Decimal? @db.Decimal(10, 2)

  note String?

  // ===========================
  // Audit
  // ===========================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([observationId])
  @@index([observationTime])
}

model ImportHistory {
  id String @id @default(uuid())

  filename String

  stationId String?
  station   Station? @relation(fields: [stationId], references: [id])

  importType ImportType

  totalRows Int

  successRows Int

  failedRows Int

  duplicateRows Int @default(0)

  importedBy String

  startedAt DateTime

  finishedAt DateTime?

  createdAt DateTime @default(now())

  importErrors ImportError[]

  observations Observation[]
}

model ImportError {
  id String @id @default(uuid())

  historyId String
  history   ImportHistory @relation(fields: [historyId], references: [id])

  rowNumber Int

  columnName String?

  message String

  createdAt DateTime @default(now())
}

model ImportDraft {
  id String @id @default(uuid())

  filename String

  importType ImportType

  metadata Json

  rows Json

  summary Json

  createdBy String

  expiresAt DateTime

  createdAt DateTime @default(now())
}

// ===========================
// Rekomtek Berkas Template
// ===========================

model RekomtekBerkasTemplate {
  id String @id @default(uuid())

  // Kategori
  jenis           String // GALIAN_C, APU, PLTA, PLTM, etc
  jenisPermohonan JenisPermohonan

  // Identitas item
  kode        String // "1", "12.a", "12.b" — untuk display & grouping
  nomorUrut   Int // untuk sorting
  uraian      String // Nama berkas / deskripsi
  isRequired  Boolean @default(true)
  hasSubItems Boolean @default(false)

  // Kebijakan sumber dan validasi per item
  allowedSourceTypes   Json   @default("[\"GOOGLE_DRIVE\"]")
  sensitivity          String @default("ORDINARY")
  accessPolicy         String @default("DRIVE_PUBLIC_ONLY")
  allowedMimeTypes     Json?
  maxFileSize          Int?
  allowedExportFormats Json?

  // Relasi ke instance berkas (optional — untuk tracking)
  berkasItems RekomtekBerkas[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jenis, jenisPermohonan, kode])
  @@index([jenis, jenisPermohonan])
}

// ===========================
// Rekomtek Berkas (Instance)
// ===========================

model RekomtekBerkas {
  id String @id @default(uuid())

  rekomtekId String
  rekomtek   Rekomtek @relation(fields: [rekomtekId], references: [id], onDelete: Cascade)

  templateId String?
  template   RekomtekBerkasTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Copy dari template (bisa diubah)
  kode       String // "1", "12.a"
  nomorUrut  Int
  uraian     String
  isRequired Boolean @default(true)

  // Snapshot kebijakan template
  allowedSourceTypes   Json   @default("[\"GOOGLE_DRIVE\"]")
  sensitivity          String @default("ORDINARY")
  accessPolicy         String @default("DRIVE_PUBLIC_ONLY")
  allowedMimeTypes     Json?
  maxFileSize          Int?
  allowedExportFormats Json?

  // Status kelengkapan
  isComplete       Boolean               @default(false)
  reviewStatus     BerkasReviewStatus    @default(PENDING)
  technicalStatus  BerkasTechnicalStatus @default(PENDING_CHECK)
  technicalCode    String?
  technicalMessage String?
  checkedAt        DateTime?
  sourceVersion    Int                   @default(0)
  sourceType       BerkasSourceType?
  driveUrl         String?
  driveFileId      String?
  driveResourceKey String?
  storageKey       String?
  notes            String?

  // Revision tracking
  revisionNote String?
  returnedAt   DateTime?

  reviewFindings RekomtekReviewFinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rekomtekId, nomorUrut, kode])
  @@index([rekomtekId, technicalStatus])
}

model RekomtekBerkasLinkHistory {
  id String @id @default(uuid())

  rekomtekBerkasId String

  oldDriveUrl     String?
  newDriveUrl     String?
  oldSourceType   BerkasSourceType?
  newSourceType   BerkasSourceType?
  oldStorageKey   String?
  newStorageKey   String?
  changeReason    String?
  technicalStatus BerkasTechnicalStatus?
  technicalCode   String?

  changedById String
  role        String
  createdAt   DateTime @default(now())

  @@index([rekomtekBerkasId, createdAt])
  @@index([createdAt])
}

// ===========================
// Rekomtek Workflow
// ===========================

model RekomtekTeamAssignment {
  id String @id @default(uuid())

  rekomtekId String
  rekomtek   Rekomtek @relation(fields: [rekomtekId], references: [id], onDelete: Cascade)

  assignedById  String
  coordinatorId String
  purpose       String
  startsAt      DateTime  @default(now())
  endsAt        DateTime?
  isActive      Boolean   @default(true)

  members RekomtekTeamMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rekomtekId, isActive])
  @@index([coordinatorId, isActive])
}

model RekomtekTeamMember {
  id String @id @default(uuid())

  assignmentId String
  assignment   RekomtekTeamAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  role         RekomtekAssignmentMemberRole
  activeFrom   DateTime                     @default(now())
  activeUntil  DateTime?

  createdAt DateTime @default(now())

  @@unique([assignmentId, userId])
  @@index([userId, activeUntil])
}

model RekomtekReviewRound {
  id String @id @default(uuid())

  rekomtekId  String
  rekomtek    Rekomtek                @relation(fields: [rekomtekId], references: [id], onDelete: Cascade)
  type        RekomtekReviewType
  roundNumber Int
  decision    RekomtekReviewDecision?
  summary     String?
  createdById String
  closedById  String?
  openedAt    DateTime                @default(now())
  closedAt    DateTime?

  findings RekomtekReviewFinding[]

  @@unique([rekomtekId, type, roundNumber])
  @@index([rekomtekId, type, openedAt])
}

model RekomtekReviewFinding {
  id String @id @default(uuid())

  reviewRoundId     String
  reviewRound       RekomtekReviewRound   @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  rekomtekBerkasId  String?
  rekomtekBerkas    RekomtekBerkas?       @relation(fields: [rekomtekBerkasId], references: [id], onDelete: SetNull)
  note              String
  applicantResponse String?
  status            RekomtekFindingStatus @default(TERBUKA)
  createdById       String
  resolvedById      String?
  createdAt         DateTime              @default(now())
  resolvedAt        DateTime?

  @@index([reviewRoundId, status])
  @@index([rekomtekBerkasId, status])
}

model RekomtekExposeSchedule {
  id String @id @default(uuid())

  rekomtekId           String
  rekomtek             Rekomtek             @relation(fields: [rekomtekId], references: [id], onDelete: Cascade)
  startsAt             DateTime
  endsAt               DateTime
  timeZone             String               @default("Asia/Jakarta")
  method               RekomtekExposeMethod
  venue                String?
  meetingUrl           String?
  agenda               String
  participants         Json
  responsibleUserId    String
  invitationNumber     String?
  invitationArtifactId String?
  status               RekomtekExposeStatus @default(DRAFT)
  actualStartsAt       DateTime?
  actualEndsAt         DateTime?
  notes                String?
  cancellationReason   String?
  createdById          String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  scheduleVersion Int @default(1)

  whatsappOutbox WhatsAppOutbox[]

  @@index([rekomtekId, status, startsAt])
  @@index([responsibleUserId, status, startsAt])
}

model RekomtekFieldVisit {
  id String @id @default(uuid())

  rekomtekId        String
  rekomtek          Rekomtek                 @relation(fields: [rekomtekId], references: [id], onDelete: Cascade)
  sptNumber         String                   @unique
  issuedAt          DateTime
  petugasId         String
  location          String
  scheduledStartsAt DateTime
  scheduledEndsAt   DateTime
  scope             String
  artifactId        String?
  status            RekomtekFieldVisitStatus @default(DITUGASKAN)
  realizedAt        DateTime?
  realizationNotes  String?
  createdById       String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([rekomtekId, status])
  @@index([petugasId, status])
}

model RekomtekCouncilSession {
  id String @id @default(uuid())

  rekomtekId   String
  rekomtek     Rekomtek @relation(fields: [rekomtekId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  completedAt  DateTime
  participants Json
  decision     String
  notes        String?
  createdById  String
  createdAt    DateTime @default(now())

  @@index([rekomtekId, completedAt])
}

model RekomtekArtifact {
  id String @id @default(uuid())

  rekomtekId       String
  rekomtek         Rekomtek               @relation(fields: [rekomtekId], references: [id], onDelete: Cascade)
  type             RekomtekArtifactType
  version          Int
  fileName         String
  storageKey       String
  mimeType         String
  fileSize         Int
  checksum         String
  technicalStatus  BerkasTechnicalStatus  @default(PENDING_CHECK)
  stage            RekomtekWorkflowStage
  status           RekomtekArtifactStatus @default(DRAFT)
  sourceArtifactId String?
  createdById      String
  finalizedById    String?
  finalizedAt      DateTime?
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([rekomtekId, type, version])
  @@index([rekomtekId, type, status])
  @@index([storageKey])
}

model RekomtekWorkflowEvent {
  id String @id @default(uuid())

  rekomtekId       String
  rekomtek         Rekomtek               @relation(fields: [rekomtekId], references: [id], onDelete: Cascade)
  fromStage        RekomtekWorkflowStage?
  toStage          RekomtekWorkflowStage
  action           String
  actorId          String
  actorRole        String
  actorPermissions Json?
  reason           String?
  metadata         Json?
  createdAt        DateTime               @default(now())

  whatsappOutbox WhatsAppOutbox[]

  @@index([rekomtekId, createdAt])
  @@index([actorId, createdAt])
}

model RekomtekNotification {
  id String @id @default(uuid())

  rekomtekId  String
  rekomtek    Rekomtek              @relation(fields: [rekomtekId], references: [id], onDelete: Cascade)
  recipientId String
  stage       RekomtekWorkflowStage
  title       String
  message     String
  eventId     String?
  readAt      DateTime?
  createdAt   DateTime              @default(now())

  whatsappOutbox WhatsAppOutbox[]

  @@index([recipientId, readAt, createdAt])
  @@index([rekomtekId, createdAt])
}

// ===========================
// Flowchart (Alur Publik)
// ===========================

model Flowchart {
  id String @id @default(uuid())

  // Identitas
  slug        String  @unique
  title       String
  description String?

  // Publikasi
  isPublished Boolean @default(true)

  // Konten grafik — array JSON dari node & edge (format React Flow)
  nodes Json @default("[]")
  edges Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ===========================
// Peta GIS (upload .kmz/.kml)
// ===========================

model GisMap {
  id          String  @id @default(uuid())
  name        String
  category    String // PETA_POS_HIDROLOGI | PETA_WILAYAH_SUNGAI | ...
  description String?

  // File asli (.kmz/.kml) — disimpan untuk diunduh
  fileUrl  String
  fileName String
  fileSize Int

  // Hasil konversi KMZ/KML → GeoJSON FeatureCollection (untuk viewer)
  geometry    Json?
  hasGeometry Boolean @default(false)

  status      Boolean   @default(true)
  publishedAt DateTime?

  sourceRiverRegions RiverRegion[] @relation("RiverRegionSourceMap")
  sourceWatersheds   Watershed[]   @relation("WatershedSourceMap")
  sourceRivers       River[]       @relation("RiverSourceMap")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status, publishedAt])
}

// ===========================
// Berita Sipengsui
// ===========================

model NewsCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  articles NewsArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsTag {
  id       String  @id @default(uuid())
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  articles NewsArticleTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsArticle {
  id String @id @default(uuid())

  title       String
  slug        String  @unique
  excerpt     String?
  contentJson Json
  contentHtml String

  coverImageUrl     String?
  coverImageAlt     String?
  coverImageCaption String?

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?

  status      NewsStatus @default(DRAFT)
  isFeatured  Boolean    @default(false)
  scheduledAt DateTime?
  publishedAt DateTime?
  archivedAt  DateTime?
  viewCount   Int        @default(0)

  authorId String
  author   User   @relation("NewsArticleAuthor", fields: [authorId], references: [id])

  categoryId String?
  category   NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags      NewsArticleTag[]
  revisions NewsArticleRevision[]
  redirects NewsSlugRedirect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([isFeatured, status])
}

model NewsArticleTag {
  articleId String
  tagId     String

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     NewsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([articleId, tagId])
  @@index([tagId])
}

model NewsArticleRevision {
  id        String      @id @default(uuid())
  articleId String
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  version     Int
  isDraft     Boolean @default(true)
  title       String
  slug        String
  excerpt     String?
  contentJson Json
  contentHtml String

  coverImageUrl     String?
  coverImageAlt     String?
  coverImageCaption String?
  seoTitle          String?
  seoDescription    String?
  canonicalUrl      String?
  categoryId        String?
  tagIds            Json      @default("[]")
  scheduledAt       DateTime?
  publishedAt       DateTime?
  note              String?

  createdById String
  createdBy   User   @relation("NewsRevisionAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([articleId, version])
  @@index([articleId, createdAt])
  @@index([articleId, isDraft])
}

// ===========================
// WhatsApp Bot MVP
// ===========================

model WhatsAppIdentity {
  id String @id @default(uuid())

  phoneE164    String  @unique
  providerWaId String? @unique
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status     WhatsAppIdentityStatus @default(ACTIVE)
  verifiedAt DateTime?
  linkedAt   DateTime?
  unlinkedAt DateTime?
  blockedAt  DateTime?
  lastSeenAt DateTime?

  pairingAttemptCount           Int       @default(0)
  pairingAttemptWindowStartedAt DateTime?

  consents       WhatsAppConsent[]
  consentAudits  WhatsAppConsentAuditEvent[]
  identityAudits WhatsAppIdentityAuditEvent[]
  conversation   WhatsAppConversation?
  inboundEvents  WhatsAppInboundEvent[]
  outboxMessages WhatsAppOutbox[]
  outboxSkips    WhatsAppOutboxSkipEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, verifiedAt])
  @@index([userId, status])
}

model WhatsAppConsent {
  id          String                 @id @default(uuid())
  identityId  String
  identity    WhatsAppIdentity       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  purpose     WhatsAppConsentPurpose
  active      Boolean                @default(false)
  source      WhatsAppConsentSource
  textVersion String
  actorUserId String?
  optedInAt   DateTime?
  optedOutAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identityId, purpose])
  @@index([identityId, purpose, active])
}

model WhatsAppPairingCode {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String @unique

  status        WhatsAppPairingStatus @default(PENDING)
  expiresAt     DateTime
  attemptCount  Int                   @default(0)
  maxAttempts   Int                   @default(5)
  lastAttemptAt DateTime?
  consumedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime              @default(now())

  @@index([userId, status, expiresAt])
  @@index([codeHash, status, expiresAt])
}

model WhatsAppConsentAuditEvent {
  id          String                 @id @default(uuid())
  identityId  String
  identity    WhatsAppIdentity       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  purpose     WhatsAppConsentPurpose
  active      Boolean
  source      WhatsAppConsentSource
  textVersion String
  actorUserId String?
  createdAt   DateTime               @default(now())

  @@index([identityId, purpose, createdAt])
  @@index([actorUserId, createdAt])
}

model WhatsAppIdentityAuditEvent {
  id          String           @id @default(uuid())
  identityId  String
  identity    WhatsAppIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  action      String
  actorUserId String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([identityId, createdAt])
  @@index([actorUserId, createdAt])
}

model WhatsAppConversation {
  id                           String                    @id @default(uuid())
  identityId                   String                    @unique
  identity                     WhatsAppIdentity          @relation(fields: [identityId], references: [id], onDelete: Cascade)
  state                        WhatsAppConversationState @default(MENU)
  stateExpiresAt               DateTime?
  serviceWindowExpiresAt       DateTime?
  lastInboundAt                DateTime?
  lastOutboundAt               DateTime?
  lastMessageAt                DateTime?
  aiRequestCount               Int                       @default(0)
  aiRequestWindowStartedAt     DateTime?
  statusRequestCount           Int                       @default(0)
  statusRequestWindowStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, stateExpiresAt])
  @@index([serviceWindowExpiresAt])
}

model WhatsAppInboundEvent {
  id                String                @id @default(uuid())
  providerRequestId String                @unique
  eventName         String
  sessionName       String
  providerEngine    String?
  providerEventId   String                @unique
  providerMessageId String?               @unique
  identityId        String
  identity          WhatsAppIdentity      @relation(fields: [identityId], references: [id], onDelete: Cascade)
  messageType       WhatsAppMessageType
  textBody          String?
  payloadDigest     String
  providerTimestamp DateTime?
  receivedAt        DateTime              @default(now())
  status            WhatsAppInboundStatus @default(RECEIVED)
  attemptCount      Int                   @default(0)
  nextAttemptAt     DateTime?             @default(now())
  errorCode         String?
  processedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([identityId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt, receivedAt])
  @@index([eventName, createdAt])
  @@index([providerMessageId])
}

model WhatsAppOutbox {
  id                  String                 @id @default(uuid())
  recipientIdentityId String
  recipientIdentity   WhatsAppIdentity       @relation(fields: [recipientIdentityId], references: [id], onDelete: Cascade)
  channel             String                 @default("WHATSAPP")
  provider            String                 @default("legacy")
  purpose             WhatsAppConsentPurpose
  consentRequired     Boolean                @default(true)
  messageKey          String
  messageVersion      String                 @default("v1")
  language            String
  textBody            String?
  textSnapshotHash    String?
  dedupeKey           String                 @unique

  domainEventId          String?
  domainEventVersion     Int?
  workflowEventId        String?
  workflowEvent          RekomtekWorkflowEvent?  @relation(fields: [workflowEventId], references: [id], onDelete: SetNull)
  rekomtekNotificationId String?
  rekomtekNotification   RekomtekNotification?   @relation(fields: [rekomtekNotificationId], references: [id], onDelete: SetNull)
  scheduleId             String?
  schedule               RekomtekExposeSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleVersion        Int?

  status            WhatsAppOutboxStatus @default(PENDING)
  attemptCount      Int                  @default(0)
  maxAttempts       Int                  @default(6)
  nextAttemptAt     DateTime             @default(now())
  leaseUntil        DateTime?
  lockedBy          String?
  sendStartedAt     DateTime?
  providerMessageId String?              @unique
  lastErrorCode     String?
  lastErrorMessage  String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  deliveryEvents WhatsAppDeliveryEvent[]

  @@index([status, nextAttemptAt])
  @@index([provider, status, nextAttemptAt])
  @@index([recipientIdentityId, status])
  @@index([providerMessageId])
  @@index([scheduleId, scheduleVersion])
  @@index([workflowEventId])
}

model WhatsAppDeliveryEvent {
  id                String                 @id @default(uuid())
  outboxId          String?
  outbox            WhatsAppOutbox?        @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  providerEventId   String                 @unique
  providerMessageId String?
  status            WhatsAppDeliveryStatus
  providerAck       Int?
  providerStatus    String?
  providerTimestamp DateTime?
  createdAt         DateTime               @default(now())

  @@index([outboxId, createdAt])
  @@index([providerMessageId, createdAt])
}

model WhatsAppAdminAuditEvent {
  id          String   @id @default(uuid())
  action      String
  actorUserId String
  outboxId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([outboxId, createdAt])
}

model WhatsAppDispatchLock {
  name        String    @id
  lockedUntil DateTime?
  lockedBy    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WhatsAppOutboxSkipEvent {
  id                  String                 @id @default(uuid())
  recipientUserId     String?
  recipientIdentityId String?
  recipientIdentity   WhatsAppIdentity?      @relation(fields: [recipientIdentityId], references: [id], onDelete: SetNull)
  purpose             WhatsAppConsentPurpose
  messageKey          String
  messageVersion      String
  domainEventId       String?
  reason              String
  dedupeKey           String                 @unique
  createdAt           DateTime               @default(now())

  @@index([reason, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([recipientIdentityId, createdAt])
}

model NewsSlugRedirect {
  id        String      @id @default(uuid())
  articleId String
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fromSlug  String      @unique

  createdAt DateTime @default(now())

  @@index([articleId])
}
